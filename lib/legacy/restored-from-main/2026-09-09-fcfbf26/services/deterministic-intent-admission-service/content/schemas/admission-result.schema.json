{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deterministic-intent-admission.actions.561.group/schemas/admission-result.schema.json",
  "title": "Deterministic intent admission result",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "taskType", "objective", "desiredUse", "context", "outputSchema", "constraints"],
  "properties": {
    "type": {"const": "BoundedInferenceWorkLotIntent"},
    "taskType": {"type": "string"},
    "objective": {"type": "string"},
    "desiredUse": {"type": "string"},
    "context": {"type": "object"},
    "outputSchema": {"type": "object"},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["considerationPolicy", "refinement", "upwardEscalationAuthorized", "customerAcceptanceRequired"],
      "properties": {
        "considerationPolicy": {"type": "object"},
        "refinement": {"const": "market-pressure"},
        "upwardEscalationAuthorized": {"const": false},
        "customerAcceptanceRequired": {"const": true}
      }
    }
  }
}
