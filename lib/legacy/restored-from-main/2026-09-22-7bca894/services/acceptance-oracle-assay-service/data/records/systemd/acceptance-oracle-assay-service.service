[Unit]
Description=Deterministic acceptance-oracle evidence assay A2A provider
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/acceptance-oracle-assay-service
Environment=HOST=127.0.0.1
Environment=PORT=19845
Environment=BASE_URL=https://bare-cedar-fog.561.group/a2a/acceptance-oracle-assay
Environment=AGENT_CARD_SIGNING_KEY=data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=acceptance-oracle-assay-service-ed25519
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node scripts/server.mjs
